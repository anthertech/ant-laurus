  "main_section_html": "<div class=\"content\">\n    {% set student_email = frappe.session.user %}\n    {% set student = frappe.get_list('Student', filters={'student_email_id': student_email}, fields=['name', 'title']) %}\n\n    {% if student %}\n        {% set student_name = student[0].name %}\n        {% set student_title = student[0].title %}\n\n        {% set syllabus_updates = frappe.db.sql(\"\"\"\n            SELECT\n                dsu.name\n            FROM\n                `tabDaily Syllabus Update` AS dsu\n            INNER JOIN\n                `tabStudent Group` AS sg\n            ON\n                dsu.student_group = sg.name\n            INNER JOIN\n                `tabStudent Group Student` AS sgs\n            ON\n                sg.name = sgs.parent\n            WHERE\n                sgs.student = %s AND dsu.status = 'Completed'\n            ORDER BY\n                dsu.creation DESC\n        \"\"\", student_name, as_dict=True) %}\n\n        {% if syllabus_updates %}\n            <h2 style=\"text-align: center; margin-bottom: 20px;\">Syllabus Updates</h2>\n            {% for update in syllabus_updates %}\n                {% set doc = frappe.get_doc('Daily Syllabus Update', update.name) %}\n\n                {% set confirmation = frappe.db.exists('Daily Syllabus Confirmation', {\n                    'student_id': student_name,\n                    'parent': doc.name\n                }) %}\n\n<style>\n    /* Default table styles for both confirmed and unconfirmed tables */\n    table {\n        width: 100%;\n        margin: 20px auto;\n        border: 1px solid #ddd;\n        border-collapse: collapse;\n        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.1);\n        text-align: left;\n        border-radius: 5px;\n        overflow: hidden;\n        opacity: 0;\n        transform: scale(0.9);\n        animation: fadeInScale 0.6s ease-out forwards;\n    }\n\n    @keyframes fadeInScale {\n        0% {\n            opacity: 0;\n            transform: scale(0.9);\n        }\n        100% {\n            opacity: 1;\n            transform: scale(1);\n        }\n    }\n\n    th {\n        padding: 3px;\n        text-align: center;\n    }\n\n    .unconfirmed-table {\n        width: 80%;\n        font-size: 10px;\n        background-color: ;\n        transition: background-color 0.3s ease-in-out, transform 0.3s ease;\n    }\n\n    .unconfirmed-table:hover {\n        transform: translateY(-5px);\n    }\n\n    .confirmed-table {\n    width: 70%;\n    font-size: 9px;\n    background-color: #f0f0f0; /* Light grey background */\n    transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n\n    .confirmed-table:hover {\n        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);\n    }\n\n    @media (min-width: 768px) {\n        .unconfirmed-table {\n            width: 40%;\n        }\n\n        .confirmed-table {\n            width: 30%;\n            font-size: 8px;\n        }\n    }\n\n    button {\n    padding: 1px 5px;\n    cursor: pointer;\n    display: block;\n    margin: 1px auto;\n    font-size: 12px;\n    background-color: #000; /* Black background */\n    color: #fff; /* White text */\n    border: none;\n    border-radius: 5px;\n    transition: background-color 0.3s, transform 0.2s;\n}\n\n\n    button:hover {\n        background-color: #0056b3;\n        transform: scale(1.05) rotate(-1deg);\n    }\n\n    button:disabled {\n        background-color: #ccc;\n        cursor: not-allowed;\n        margin: 0px auto;\n        font-size: 9px;\n        border-radius: 5px;\n    }\n\n    .loader {\n        border: 3px solid #f3f3f3;\n        border-top: 3px solid #007bff;\n        border-radius: 50%;\n        width: 20px;\n        height: 20px;\n        animation: spin 1s linear infinite, bounce 0.5s alternate infinite;\n        display: inline-block;\n        margin-left: 5px;\n    }\n\n    @keyframes spin {\n        0% {\n            transform: rotate(0deg);\n        }\n        100% {\n            transform: rotate(360deg);\n        }\n    }\n\n    @keyframes bounce {\n        from {\n            transform: translateY(0);\n        }\n        to {\n            transform: translateY(-5px);\n        }\n    }\n</style>\n\n\n\n\n\n\n\n                <table id=\"table-{{ update.name }}\" class=\"{% if confirmation %}confirmed-table{% else %}unconfirmed-table{% endif %}\">\n                    <tr>\n                        <th>Course: {{ doc.course }}</th>\n                    </tr>\n                    <tr>\n                        <th>Topic: {{ doc.topic }}</th>\n                    </tr>\n                    <tr>\n                        <th>Instructor: {{ doc.instructor }}</th>\n                    </tr>\n                    <tr>\n                        <th>Status: {{ doc.status }}</th>\n                    </tr>\n                  \n                    <tr>\n                        <th>\n                            {% if confirmation %}\n                                <button disabled>Confirmed</button>\n                            {% else %}\n                                <button\n                                    type=\"button\"\n                                    class=\"confirmation-btn\"\n                                    id=\"button-{{ update.name }}\"\n                                    onclick=\"confirmSyllabus('{{ student_name }}', '{{ update.name }}')\">\n                                    Confirm Syllabus\n                                </button>\n                                <span id=\"loader-{{ update.name }}\" class=\"loader\" style=\"display: none;\"></span>\n                            {% endif %}\n                        </th>\n                    </tr>\n                </table>\n            {% endfor %}\n        {% else %}\n            <p style=\"text-align: center;\">No syllabus updates found for your student group.</p>\n        {% endif %}\n    {% else %}\n        <p style=\"text-align: center;\">You are not registered as a student.</p>\n    {% endif %}\n</div>\n\n<script>\n    function confirmSyllabus(studentName, dsuName) {\n        // Show the loader\n        const loader = document.getElementById(`loader-${dsuName}`);\n        loader.style.display = 'inline-block';\n\n        frappe.call({\n            method: \"ant_laurus.ant_laurus.api.daily_syllabus.confirm_syllabus\",\n            args: {\n                student_name: studentName,\n                dsu_name: dsuName\n            },\n            callback: function(response) {\n                loader.style.display = 'none'; // Hide the loader\n\n                if (response.message === \"success\") {\n                    frappe.msgprint(\"Syllabus confirmation updated successfully!\");\n\n                    // Update the button dynamically\n                    const button = document.getElementById(`button-${dsuName}`);\n                    if (button) {\n                        button.innerText = \"Confirmed\";\n                        button.disabled = true;\n                    }\n\n                    // Apply the confirmed class to the table\n                    const table = document.getElementById(`table-${dsuName}`);\n                    if (table) {\n                        table.classList.remove(\"unconfirmed-table\");\n                        table.classList.add(\"confirmed-table\");\n                    }\n                } else if (response.message === \"confirmation exist\") {\n                    frappe.msgprint(\"You have already confirmed this syllabus.\");\n                } else {\n                    frappe.msgprint(\"Failed to update syllabus confirmation.\");\n                }\n            },\n            error: function(error) {\n                loader.style.display = 'none'; // Hide the loader\n                frappe.msgprint(\"An error occurred while confirming the syllabus.\");\n                console.error(error);\n            }\n        });\n    }\n</script>\n",
